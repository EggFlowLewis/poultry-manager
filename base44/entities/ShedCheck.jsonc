{
  "name": "ShedCheck",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "shed": {
      "type": "string"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Morning Check",
        "Evening Check"
      ]
    },
    "dead": {
      "type": "integer",
      "minimum": 0
    },
    "culls": {
      "type": "integer",
      "minimum": 0
    },
    "feed": {
      "type": "number",
      "minimum": 0
    },
    "water": {
      "type": "number",
      "minimum": 0
    },
    "temp": {
      "type": "number"
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "day": {
      "type": "string"
    }
  },
  "required": [
    "owner_id",
    "staff_id",
    "staff_name",
    "shed",
    "shift",
    "dead",
    "culls",
    "feed",
    "water",
    "temp",
    "humidity",
    "logged_at",
    "day"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      },
      "data.owner_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.staff_id": "{{user.id}}"
        }
      ]
    },
    "update": {
      "$and": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}