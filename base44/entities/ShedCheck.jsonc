{
  "name": "ShedCheck",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "shed": {
      "type": "string"
    },
    "shift": {
      "type": "string",
      "enum": [
        "Morning Check",
        "Evening Check"
      ]
    },
    "dead": {
      "type": "integer",
      "minimum": 0
    },
    "culls": {
      "type": "integer",
      "minimum": 0
    },
    "feed": {
      "type": "number",
      "minimum": 0
    },
    "water": {
      "type": "number",
      "minimum": 0
    },
    "temp": {
      "type": "number"
    },
    "humidity": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "logged_at": {
      "type": "string",
      "format": "date-time"
    },
    "day": {
      "type": "string"
    },
    "imported_at": {
      "type": "string",
      "format": "date-time"
    },
    "imported_by": {
      "type": "string"
    },
    "source_reference": {
      "type": "string"
    },
    "aipz_required": {
      "type": "boolean"
    },
    "aipz_disinfectant": {
      "type": "boolean"
    },
    "aipz_wild_bird": {
      "type": "boolean"
    }
  },
  "required": [
    "owner_id",
    "staff_id",
    "staff_name",
    "shed",
    "shift",
    "dead",
    "culls",
    "feed",
    "water",
    "temp",
    "humidity",
    "logged_at",
    "day"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.staff_id": "{{user.id}}"
        }
      ]
    },
    "update": false,
    "delete": false
  }
}